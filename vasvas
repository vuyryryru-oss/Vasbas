-- STATE
-- ==========================================
local state = {
    looped    = true,
    autoStop  = true,
    speed     = 1,
    minimized = false,
}

local currentTrack = nil
local startedAt    = 0
local conns        = {}
local ui           = {}   -- referensi elemen GUI

local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(conns, c)
    return c
end

-- ==========================================
-- LOGIKA EMOTE
-- ==========================================
local function getHumanoid()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getAnimator()
    local hum = getHumanoid()
    if not hum then return nil end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = hum:WaitForChild("Animator", 3)
    end
    return animator
end

local function setStatus(text, color)
    if ui.statusText then
        ui.statusText.Text = text
        ui.statusDot.BackgroundColor3 = color
    end
end

local function refreshPlayButton()
    if not ui.playBtn then return end
    local playing = currentTrack ~= nil
    ui.playBtn.Text = playing and "STOP" or "PLAY"
    ui.playGradient.Color = playing
        and ColorSequence.new(THEME.Danger, Color3.fromRGB(170, 40, 70))
        or  ColorSequence.new(THEME.Accent, THEME.AccentAlt)
    if playing then
        setStatus("Playing", THEME.Success)
    else
        setStatus("Idle", THEME.SubText)
    end
end

local function stopEmote()
    if currentTrack then
        local t = currentTrack
        currentTrack = nil
        pcall(function() t:Stop(CONFIG.FadeTime) end)
    end
    refreshPlayButton()
end

local function playEmote()
    local animator = getAnimator()
    if not animator then
        setStatus("Animator tidak ada", THEME.Danger)
        return
    end

    stopEmote()

    local anim = Instance.new("Animation")
    anim.AnimationId = CONFIG.AnimId

    local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)

    if not (ok and track) then
        setStatus("Gagal load animasi", THEME.Danger)
        return
    end

    track.Priority = CONFIG.Priority
    track.Looped   = state.looped
    currentTrack   = track
    startedAt      = os.clock()
    track:Play(CONFIG.FadeTime)
    track:AdjustSpeed(state.speed)

    track.Stopped:Connect(function()
        if currentTrack == track then
            currentTrack = nil
            refreshPlayButton()
        end
    end)

    refreshPlayButton()
end

-- ==========================================
-- GUI HELPERS
-- ==========================================
local function make(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(parent, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function tween(inst, info, goal)
    TweenService:Create(inst, TweenInfo.new(info, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
end

local function styledButton(props, parent)
    local btn = make("TextButton", {
        BackgroundColor3 = THEME.Element,
        TextColor3       = THEME.Text,
        Font             = Enum.Font.GothamMedium,
        TextSize         = 13,
        AutoButtonColor  = false,
        BorderSizePixel  = 0,
    }, parent)
    for k, v in pairs(props) do btn[k] = v end
    corner(btn, 8)

    -- efek tekan (mobile friendly)
    connect(btn.MouseButton1Down, function()
        tween(btn, 0.08, { BackgroundTransparency = 0.25 })
    end)
    connect(btn.MouseButton1Up, function()
        tween(btn, 0.12, { BackgroundTransparency = 0 })
    end)
    connect(btn.MouseLeave, function()
        tween(btn, 0.12, { BackgroundTransparency = 0 })
    end)
    return btn
end

