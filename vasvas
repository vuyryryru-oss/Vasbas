local function makeToggle(label, key, onChange)
    local btn = styledButton({
        Size = UDim2.new(0.5, -4, 1, 0),
        Text = "",
    }, toggleRow)

    local lbl = make("TextLabel", {
        Size                   = UDim2.new(1, -36, 1, 0),
        Position               = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Text                   = label,
        TextColor3             = THEME.Text,
        Font                   = Enum.Font.GothamMedium,
        TextSize               = 11,
        TextXAlignment         = Enum.TextXAlignment.Left,
    }, btn)

    local pill = make("Frame", {
        Size             = UDim2.new(0, 24, 0, 12),
        Position         = UDim2.new(1, -30, 0.5, -6),
        BackgroundColor3 = THEME.SubText,
        BorderSizePixel  = 0,
    }, btn)
    corner(pill, 6)

    local knob = make("Frame", {
        Size             = UDim2.new(0, 8, 0, 8),
        Position         = UDim2.new(0, 2, 0.5, -4),
        BackgroundColor3 = THEME.Text,
        BorderSizePixel  = 0,
    }, pill)
    corner(knob, 4)

    local function render()
        local on = state[key]
        tween(pill, 0.15, { BackgroundColor3 = on and THEME.Accent or THEME.SubText })
        tween(knob, 0.15, { Position = on and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4) })
    end
    render()

    connect(btn.MouseButton1Click, function()
        state[key] = not state[key]
        render()
        if onChange then onChange(state[key]) end
    end)
end

